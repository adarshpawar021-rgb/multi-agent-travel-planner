# Optional LLM API Configuration
# If no API key is provided, the system seamlessly runs in intelligent offline rule-engine mode.
# To enable real LLM generation, set your API key below:

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# OR OpenAI API Key
OPENAI_API_KEY=

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=multi-agent-travel-planner-secret-key-2026
